/ The figures behind the map, for reading them exactly and for anyone who
/ cannot use the map. choropleth is a QuarterChoropleth.
.table-responsive
  table.table.table-sm.align-middle
    thead
      tr
        th scope='col' Stadtteil
        th.text-end scope='col' Drucksachen
        th.text-end scope='col' je 10.000 Menschen
    tbody
      - choropleth.ranked.each do |area|
        tr
          td
            span.legend-swatch style="background-color: #{choropleth.color(area)}"
            = safe_join(area.quarters.map { |quarter| link_to(quarter.name, quarter_path(district: quarter.district, quarter: quarter.slug)) }, ' und ')
          td.text-end= number_with_delimiter(area.count)
          td.text-end
            - if area.rate
              = number_with_delimiter(area.rate.round)
            - else
              span.text-secondary title='Zu wenige Einwohner für einen Vergleich' –
