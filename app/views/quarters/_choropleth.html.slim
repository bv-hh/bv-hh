/ A district's Stadtteile shaded by Drucksachen per resident, with its legend.
/ choropleth is a QuarterChoropleth, district the District it shows.
- url = ->(quarter) { quarter_path(district: quarter.district, quarter: quarter.slug) }
div data-controller='quarter-choropleth' data-quarter-choropleth-features-value=choropleth.features(url).to_json data-quarter-choropleth-bounds-value=district.bounds.to_json
  .quarter-choropleth.rounded.border data-quarter-choropleth-target='container'
.small.text-secondary.mt-2
  ' Drucksachen je 10.000 Menschen, die im Stadtteil wohnen:
ul.list-inline.small.mb-0
  - choropleth.shades.each do |shade|
    li.list-inline-item.me-3
      span.legend-swatch style="background-color: #{shade.color}"
      = shade.label
  - if choropleth.no_rate?
    li.list-inline-item
      span.legend-swatch style="background-color: #{QuarterChoropleth::NO_RATE}"
      ' zu wenige Einwohner
