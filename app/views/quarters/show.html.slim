- topic_slugs = [@topic&.slug].compact.presence
/ district: nil explicitly — default_url_options would otherwise scope the
/ feed to the Bezirk being browsed, and it would then drop the cross-Bezirk
/ documents this page deliberately shows.
- quarter_feed_url = feed_url(format: :rss, district: nil, quarters: [@quarter.name], topics: topic_slugs)
- quarter_page = ->(**options) { quarter_path(district: @quarter.district, quarter: @quarter.slug, **options) }
- markers_url = quarter_page.call(format: :json, page: params[:page], topic: @topic&.slug)
- topic_url = ->(topic) { quarter_page.call(topic: topic&.slug) }
- max_places = 3

- content_for :head do
  = auto_discovery_link_tag :rss, quarter_feed_url, title: "Drucksachen zu #{@quarter.name}"

/ The map leads. From lg up the title card floats on it (quarter-hero in
/ application.sass) and the map keeps its left side free; below lg the card
/ follows the map.
section.quarter-hero.position-relative.mb-5 data-controller='quarter-map' data-quarter-map-url-value=markers_url
  .quarter-hero-map.rounded.border data-quarter-map-target='container'
  .card.quarter-hero-card.mt-3.mt-lg-0 data-quarter-map-target='card'
    .card-body.p-4
      nav aria-label='Brotkrumen'
        ol.breadcrumb.small.mb-2
          li.breadcrumb-item= link_to 'Hamburg', root_path(district: nil)
          li.breadcrumb-item= link_to @quarter.district.name, root_with_district_path(district: @quarter.district)
      h1.display-6.fw-bold.mb-2= @quarter.name
      / A topic narrows the list, the map, the counts and the feed alike, so
      / the card says so where all of them are summed up.
      - if @topic
        .d-flex.flex-wrap.align-items-center.gap-2.mb-2
          span.badge.text-bg-secondary.fs-6.fw-normal= "Thema: #{@topic.label}"
          = link_to 'Filter aufheben', quarter_page.call, class: 'small'
      p.text-secondary
        - if @topic
          = "Jeder Punkt auf der Karte ist ein Ort, um den es in einer der Drucksachen zum Thema #{@topic.label} unten geht."
        - else
          | Jeder Punkt auf der Karte ist ein Ort, um den es in einer der Drucksachen unten geht.
      p.small.text-secondary.d-none data-quarter-map-target='empty'
        | Zu den Drucksachen auf dieser Seite ist kein Ort mit Koordinaten hinterlegt.
      .d-flex.gap-4.mb-3
        div
          .fs-4.fw-bold.lh-1= number_with_delimiter(@documents.total_count)
          .small.text-secondary Drucksachen
        div
          .fs-4.fw-bold.lh-1= number_with_delimiter(@location_count)
          .small.text-secondary Orte
      = link_to quarter_feed_url, class: 'btn btn-primary w-100', rel: 'alternate', type: 'application/rss+xml' do
        = icon('fas', 'rss', @topic ? "#{@topic.label} in #{@quarter.name} abonnieren" : "Neues aus #{@quarter.name} abonnieren")
      p.small.mb-0.mt-2
        = link_to 'Mehrere Stadtteile oder Straßen beobachten', feed_path(district: nil, quarters: [@quarter.name], topics: topic_slugs)

= render 'meetings/upcoming', upcoming: @upcoming, area_name: @quarter.name

.row.g-5.mb-5
  - if @topic_counts.present?
    aside.col-lg-3.d-none.d-lg-block aria-labelledby='topics-heading'
      h2#topics-heading.h5 Nach Thema filtern
      = render 'topics/filter', items: @topic_counts, active: @topic, url: topic_url
      - if @topic
        = link_to "#{@topic.label} in allen Bezirken", topic_path(topic: @topic, district: nil), class: 'd-inline-block small mt-2'

  section.col aria-labelledby='documents-heading'
    .d-flex.flex-wrap.justify-content-between.align-items-baseline.column-gap-3.mb-2
      h2#documents-heading.mb-0 Neueste Drucksachen
      - if @documents.any?
        span.small.text-secondary
          = "#{number_with_delimiter @documents.total_count} betreffen #{@quarter.name}#{" zum Thema #{@topic.label}" if @topic}"

    / Below lg the topics are one row to swipe through instead of a sidebar.
    - if @topic_counts.present?
      = render 'topics/filter_row', items: @topic_counts, active: @topic, url: topic_url
      - if @topic
        = link_to "#{@topic.label} in allen Bezirken", topic_path(topic: @topic, district: nil), class: 'd-inline-block d-lg-none small mb-3'

    - if @documents.any?
      / A street crossing a Bezirk boundary puts documents from a neighbouring
      / Bezirk on this page. That is intended, but it has to be visible.
      .list-group.list-group-flush
        - @documents.each do |document|
          - places = @places.fetch(document.id, [])
          / The last meeting dates a Drucksache; created_at would not, as it is
          / when BV-HH imported it (thousands of old ones on the same day).
          - meeting = document.meetings.max_by(&:date)
          .list-group-item.px-0
            = link_to document.title.html_safe, document_path(document, district: document.district)
            .small.text-secondary
              => document.number
              ' ·
              = document.kind
              - if document.district != @quarter.district
                span.badge.bg-light.text-secondary.border.ms-1= document.district.name
            - if meeting
              .small
                = link_to meeting.committee&.name || meeting.title, meeting_path(meeting, district: document.district),
                    class: 'text-secondary'
                span.text-secondary= " · #{l meeting.date}"
            - if places.any?
              .d-flex.flex-wrap.gap-1.mt-1
                - places.first(max_places).each do |location|
                  = link_to location.name, location_path(location, district: location.district),
                      class: 'btn btn-sm btn-outline-secondary py-0'
                - if places.size > max_places
                  span.small.text-secondary.align-self-center= "+ #{places.size - max_places} weitere"

      .mt-4
        = paginate @documents, theme: 'bootstrap-5', nav_class: 'nav justify-content-center'
    - else
      p.mt-2 Zu diesem Stadtteil sind bisher keine Drucksachen erfasst.

- if @neighbours.any?
  section.mb-5 aria-labelledby='neighbours-heading'
    h2#neighbours-heading.h5 Nachbarstadtteile
    .d-flex.flex-wrap.gap-2
      - @neighbours.each do |neighbour|
        = link_to neighbour.name, quarter_path(district: neighbour.district, quarter: neighbour.slug),
            class: 'btn btn-sm btn-outline-secondary'

.alert.alert-warning.mb-0
  strong> Keine offizielle Seite der Stadt Hamburg.
  ' Alle Inhalte stammen aus den Ratsinformationssystemen der Bezirke. Über das Symbol
  => allris_icon
  ' gelangen Sie zur jeweiligen Quelle, nur dort sind verbindliche Informationen zu finden.
  = link_to 'Wozu dann das hier?', about_path(district: nil), class: 'alert-link'
