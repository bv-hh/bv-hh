- quarter_count = @quarter_names.values.sum(&:size)

.home
  .card.p-4.p-lg-5.mb-5.bg-body-tertiary.rounded-3
    .row.g-5
      .col-lg-7
        p.text-uppercase.fw-bold.small.text-secondary.mb-2 Bezirkspolitik in Hamburg
        h1.display-5.fw-bold.mb-3 Was entscheidet Ihr Bezirk?
        p.lead.mb-4
          | Alle öffentlichen Drucksachen, Sitzungen und Protokolle der sieben Hamburger Bezirksversammlungen –
            durchsuchbar nach Straße, Stadtteil und Thema.

        = render 'search/hero', label: 'Suche in allen Bezirken'

        .d-flex.flex-wrap.gap-4.mt-4
          - [[@document_counts.values.sum, 'Drucksachen'], [@meeting_count, 'Sitzungen'],
             [quarter_count, 'Stadtteile'], [@districts.size, 'Bezirksversammlungen']].each do |value, label|
            div
              .fs-3.fw-bold.lh-1= number_with_delimiter(value)
              .small.text-secondary= label

      - if @next_assemblies.present?
        .col-lg-5
          .card
            .card-body.pb-2
              h2.h5.card-title Nächste Bezirksversammlungen
              p.card-subtitle.small.text-secondary Öffentlich, mit Fragestunde für Bürgerinnen und Bürger.
            .list-group.list-group-flush
              - @next_assemblies.each do |meeting|
                .list-group-item.list-group-item-action.position-relative.d-flex.align-items-center
                  = link_to l(meeting.date, format: '%a %d.%m.'), meeting_path(meeting, district: meeting.district),
                      class: 'stretched-link fw-bold text-nowrap col-3'
                  span.flex-grow-1= meeting.district.name
                  small.text-secondary.text-nowrap= days_until(meeting.date)

  section.mb-5
    .d-flex.flex-wrap.justify-content-between.align-items-baseline.column-gap-3.mb-3
      h2.mb-0 Die sieben Bezirke
      p.text-secondary.mb-0 Jeder Bezirk hat eine eigene Bezirksversammlung mit Ausschüssen.
    .row.row-cols-1.row-cols-sm-2.row-cols-lg-4.g-3
      - @districts.each do |district|
        - quarters = @quarter_names[district.number] || []
        .col
          .card.h-100
            .card-body.d-flex.flex-column
              h3.h5.card-title
                = link_to district.name, root_with_district_path(district), class: 'stretched-link text-decoration-none'
              p.card-text.small.text-secondary
                = quarters.first(5).join(', ')
                - if quarters.size > 5
                  |  …
              p.card-text.small.mt-auto
                strong>= number_with_delimiter(@document_counts[district.id].to_i)
                ' Drucksachen ·
                strong>= quarters.size
                | Stadtteile
      .col
        .card.h-100.bg-body-tertiary
          .card-body
            h3.h5.card-title
              = link_to 'Welcher Bezirk ist meiner?', map_path, class: 'stretched-link text-decoration-none'
            p.card-text.small.text-secondary Auf der Karte sehen, welche Drucksachen Orte in Ihrer Nähe betreffen.

  - if @topic_counts.present?
    section.mb-5
      .row.g-4
        .col-lg-4
          h2 Worüber beraten wird
          p.text-secondary
            | Jede Drucksache ist automatisch einem von #{Topic.count} Themen zugeordnet. Die häufigsten in allen
              Bezirken:
        .col-lg-8
          = render 'topics/bars', items: @topic_counts, top: PagesController::TOP_TOPICS,
                   url: ->(topic) { topic_path(topic:, district: nil) }

  = render 'pages/participation', heading: 'Mitmachen'

  .alert.alert-warning.mb-0
    strong> Keine offizielle Seite der Stadt Hamburg.
    ' Alle Inhalte stammen aus den Ratsinformationssystemen der Bezirke. Über das Symbol
    => allris_icon
    ' gelangen Sie zur jeweiligen Quelle, nur dort sind verbindliche Informationen zu finden.
    = link_to 'Wozu dann das hier?', about_path, class: 'alert-link'
