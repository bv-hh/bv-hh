/ search_page changes one part of the current search and keeps the rest.
/ nil drops a part; district: nil is the search in all Bezirke, which
/ default_url_options would otherwise fill in with the current one.
- search_page = ->(**changes) { search_path(**@filters, **changes) }
- scope_name = @district&.name || 'allen Bezirken'

.search
  nav aria-label='Brotkrumen'
    ol.breadcrumb
      li.breadcrumb-item= link_to 'Hamburg', root_path(district: nil)
      - if @district
        li.breadcrumb-item= link_to @district.name, root_with_district_path(district: @district)
      li.breadcrumb-item.active aria-current='page' Suche

  .card.p-4.p-lg-5.mb-4.bg-body-tertiary.rounded-3
    p.text-uppercase.fw-bold.small.text-secondary.mb-2 Suche
    h1.h2.fw-bold.mb-4= @term.present? ? "Ergebnisse für „#{@term}“" : 'Was suchen Sie?'

    .col-xl-9
      = render 'search/hero', label: "In #{scope_name} suchen", value: @term, examples: @term.blank?

    - if @term.present?
      - active_filters = [[@topic && "Thema: #{@topic.label}", { topic: nil }], [@kind && "Art: #{@kind}", { kind: nil }],
                          [@attachments && 'Auch in Anhängen', { attachments: nil }]].select(&:first)
      - if active_filters.any?
        .d-flex.flex-wrap.align-items-center.gap-2.mt-3
          - active_filters.each do |label, change|
            = filter_token(label, search_page.call(**change))

      / The Bezirk links keep the minutes tab when it was chosen: switching
      / Bezirk is still the same question. Opened only because the Drucksachen
      / had nothing, it is no choice to keep.
      - tab = ('protokolle' if @tab == :minutes && params[:tab] == 'protokolle')
      - totals = @district_counts[:documents].merge(@district_counts[:minutes]) { |_id, documents, minutes| documents + minutes }
      section.mt-4
        h2.h6.mb-2 Treffer nach Bezirk
        nav.d-flex.flex-wrap.gap-2 aria-label='Bezirke'
          = filter_chip('Alle Bezirke', search_page.call(district: nil, tab:), selected: @district.nil?,
              count: totals.values.sum, current: 'page')
          - District.by_order.each do |district|
            - count = totals[district.id].to_i
            - next if count.zero? && district != @district
            = filter_chip(district.name, search_page.call(district:, tab:), selected: district == @district, count:, current: 'page')

  - if @term.present?
    - if @matches.any?
      section.mb-4 aria-label='Direkte Treffer'
        .row.g-3
          - if (quarter = @matches.quarter)
            .col-md
              .card.h-100
                .card-body
                  .small.text-uppercase.fw-bold.text-secondary.mb-1 Stadtteil
                  h2.h5.card-title
                    = link_to quarter.name, quarter_path(district: quarter.district, quarter: quarter.slug), class: 'stretched-link'
                  p.card-text.small.text-secondary
                    = "Karte und Drucksachen zu Orten in #{quarter.name}, Bezirk #{quarter.district.name}."
          - if (street = @matches.street)
            .col-md
              .card.h-100
                .card-body
                  .small.text-uppercase.fw-bold.text-secondary.mb-1 Straße
                  h2.h5.card-title= street.name
                  - if street.quarters.any?
                    p.card-text.small.text-secondary.mb-1 Verläuft durch
                    .d-flex.flex-wrap.gap-1.mb-2
                      - street.quarters.each do |quarter|
                        = quarter_chip(quarter, dense: true)
                  = link_to feed_path(district: nil, streets: [street.name]), class: 'small' do
                    = icon('fas', 'rss', 'Straße beobachten')
          - if (topic = @matches.topic)
            .col-md
              .card.h-100
                .card-body
                  .small.text-uppercase.fw-bold.text-secondary.mb-1 Thema
                  h2.h5.card-title= link_to topic.label, topic_path(topic:)
                  p.card-text.small.text-secondary.mb-1= "Alle Drucksachen zum Thema in #{scope_name}."
                  - unless topic == @topic
                    = link_to 'Suche auf dieses Thema eingrenzen', search_page.call(topic: topic.slug), class: 'small'

    .row.g-5.mb-5
      / Below lg the topics sit above the list (topics/filter_row) and the
      / remaining filters follow it.
      aside.col-lg-3.order-last.order-lg-first aria-label='Filter'
        - if @topic_counts.present?
          .d-none.d-lg-block.mb-4
            h2.h5 Nach Thema filtern
            = render 'topics/filter', items: @topic_counts, active: @topic, url: ->(topic) { search_page.call(topic: topic&.slug) }

        h2.h5 Weitere Filter
        = form_tag search_path, method: :get do
          - @filters.slice(:q, :topic, :order).each do |name, value|
            = hidden_field_tag name, value, id: nil
          - if @kinds.any?
            label.form-label.small for='kind' Drucksachenart
            = select_tag :kind, options_for_select(@kinds, @kind), include_blank: 'Alle Arten', class: 'form-select form-select-sm mb-3'
          .form-check.form-switch.mb-3
            = check_box_tag :attachments, 'true', @attachments, class: 'form-check-input', role: 'switch'
            label.form-check-label.small for='attachments' Auch in Anhängen suchen
          button.btn.btn-sm.btn-outline-secondary type='submit' Anwenden

      section.col aria-labelledby='results-heading'
        h2#results-heading.visually-hidden Ergebnisse
        .d-flex.flex-wrap.justify-content-between.align-items-center.column-gap-3.row-gap-2.mb-3
          ul.nav.nav-underline
            li.nav-item
              = link_to search_page.call(tab: 'drucksachen'), class: ['nav-link', ('active' if @tab == :documents)],
                  'aria-current': (@tab == :documents ? 'page' : nil) do
                | Drucksachen
                span.ms-1.opacity-75= number_with_delimiter(@document_count)
            li.nav-item
              - if @topic
                span.nav-link.disabled title='Protokolle haben keine Themen'
                  | Protokolle
                  span.ms-1.opacity-75 –
              - else
                = link_to search_page.call(tab: 'protokolle'), class: ['nav-link', ('active' if @tab == :minutes)],
                    'aria-current': (@tab == :minutes ? 'page' : nil) do
                  | Protokolle
                  span.ms-1.opacity-75= number_with_delimiter(@agenda_item_count)
          - if @tab == :documents && @document_count > 1
            nav.small aria-label='Sortierung'
              span.text-secondary.me-1 Sortiert nach
              - [[:date, 'Datum', nil], [:relevance, 'Relevanz', 'relevance']].each_with_index do |(order, label, value), index|
                - if index.positive?
                  span.text-secondary.mx-1 |
                - if @order == order
                  strong aria-current='true'= label
                - else
                  = link_to label, search_page.call(order: value)

        - if @tab == :documents
          - if @topic_counts.present?
            = render 'topics/filter_row', items: @topic_counts, active: @topic, url: ->(topic) { search_page.call(topic: topic&.slug) }
          - if @topic
            p.small.text-secondary
              | Die Themen werden automatisch zugeordnet. Protokolle haben keine Themen und fehlen deshalb.

          - if @document_count.positive?
            = render 'search/results', results: @documents, count: @document_count do |document|
              / places are those named in the search first.
              = render 'documents/item', document:, places: @places.fetch(document.id, []), words: @term.split,
                  excerpt: highlight_multi_excerpt(document.full_text, @term),
                  attachments_excerpt: (highlight_multi_excerpt(document.attachments_content, @term) if @attachments),
                  topics: document.topic_records - [@topic], topic_url: ->(topic) { search_page.call(topic: topic.slug) },
                  topic_title: ->(topic) { "Suche auf das Thema #{topic.label} eingrenzen" },
                  district_url: ->(district) { search_page.call(district:) }
          - else
            = render 'search/none', what: 'Drucksachen', counts: @district_counts[:documents], search_page:, scope_name:

        - elsif @agenda_item_count.positive?
          = render 'search/results', results: @agenda_items, count: @agenda_item_count do |agenda_item|
            = render 'search/agenda_item', agenda_item:, district_url: ->(district) { search_page.call(district:, tab: 'protokolle') }
        - else
          = render 'search/none', what: 'Protokollstellen', counts: @district_counts[:minutes], tab: 'protokolle', search_page:, scope_name:

  .alert.alert-warning.mb-0
    strong> Keine offizielle Seite der Stadt Hamburg.
    ' Alle Inhalte stammen aus den Ratsinformationssystemen der Bezirke. Über das Symbol
    => allris_icon
    ' gelangen Sie zur jeweiligen Quelle, nur dort sind verbindliche Informationen zu finden.
    = link_to 'Wozu dann das hier?', about_path(district: nil), class: 'alert-link'
