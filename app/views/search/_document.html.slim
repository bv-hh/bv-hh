/ One Drucksache among the search results: title and excerpt with the search
/ words marked, then its topics and the places it mentions. places are the
/ Locations, those named in the search first; topic_url and district_url
/ narrow the search to a topic or a Bezirk.
- words = @term.split
- max_places = 3
/ The last meeting dates a Drucksache, as on the Stadtteil page.
- meeting = document.meetings.select(&:date).max_by(&:date)
.list-group-item.px-0.py-3.d-flex.gap-3
  .flex-grow-1.text-break
    = link_to highlight(strip_tags(document.title), words), document_path(document, district: document.district),
        class: 'fw-semibold'
    .small.text-secondary
      => highlight(document.number, words)
      ' ·
      = document.kind
      - if meeting
        '  ·
        = link_to meeting.committee&.name || meeting.title, meeting_path(meeting, district: document.district),
            class: 'link-secondary'
        = " · #{l meeting.date}"
    p.small.mb-0.mt-1= highlight_multi_excerpt(document.full_text, @term)
    - if @attachments && (attachments_excerpt = highlight_multi_excerpt(document.attachments_content, @term)).present?
      p.small.text-secondary.mb-0.mt-1
        span.fw-semibold> Anhänge:
        = attachments_excerpt
    - topics = document.topic_records
    - other_district = document.district != @district
    - if other_district || topics.any? || places.any?
      .d-flex.flex-wrap.align-items-center.gap-1.mt-2
        - if other_district
          = district_chip(document.district, district_url.call(document.district))
        - topics.each do |topic|
          = topic_chip(topic, topic_url.call(topic), dense: true, title: "Suche auf das Thema #{topic.label} eingrenzen")
        - places.first(max_places).each do |location|
          = place_chip(location, dense: true)
        - if places.size > max_places
          span.small.text-secondary= "+ #{places.size - max_places} weitere"
  .flex-shrink-0= allris_link(document.allris_url)
