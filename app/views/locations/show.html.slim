h1.h2
  = @location.name
h3.text-muted
  small= "Drucksachen zu #{@location.formatted_address}"

- if @location.quarters.present?
  .d-flex.flex-wrap.gap-1.mb-3
    - @location.quarters.each do |name|
      - quarter = Quarter.lookup(name)
      - next if quarter.blank? || quarter.district.blank?
      = quarter_chip(quarter, dense: true)

.beta.mb-3
  span.badge.text-bg-warning> Beta
  span.small.text-secondary Die Erkennung von Orten im Text einer Drucksache kann ungenau sein. Es ist daher möglich, dass hier nicht alle Drucksachen korrekt angezeigt werden.

.list-group.list-group-flush.mt-4
  - @documents.each do |document|
    = render 'documents/item', document:, district: @location.district, places: document_places(document, except: @location)

.mt-5
  = paginate @documents, theme: 'bootstrap-5', nav_class: "nav justify-content-center"
