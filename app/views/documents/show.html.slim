= page_header simple_format(@document.title, {}, wrapper_tag: :span), kind: "Drucksache #{@document.number}",
    crumbs: [['Drucksachen', documents_path], @document.number], actions: allris_link(@document.allris_url) do
  = @document.kind

- attachments = @document.attached.present? || @document.attachments.present?
- agenda_items = @document.agenda_items.by_meeting
- links = @document.links.transform_values { |documents| documents.for_list.to_a }
- related_documents, referenced_documents, citing_documents = links.values_at(:same, :referenced, :citing)
- linked = links.values.flatten
- similar_documents = @document.similar_documents(exclude: (referenced_documents + citing_documents).map(&:id))

- if item = agenda_items.first
  p
    ' Letzte Beratung:
    => l item.meeting.date
    => link_to item.meeting.committee.name, meeting_path(item.meeting)
    - if item.allris_id.present?
      => link_to minutes_meeting_path(item.meeting, anchor: item.id), title: "Protokoll zu #{item.number}", data: { bs_toggle: :tooltip } do
        strong= item.number
      = meeting_result_badge(item)
    - else
      = item.number

.row
  .col-md-8
    .card.mt-3
      .card-header.fw-bold Sachverhalt
      .card-body.allris-content
        == document_format(@document, :content)

    - if @document.resolution.present?
      .card.mt-3
        .card-header.fw-bold Petitum/Beschluss
        .card-body.allris-content
          == document_format(@document, :resolution)

    - if linked.present?
      .card.mt-3
        .card-header.fw-bold Verwandte Drucksachen
        .card-body.py-0
          - if related_documents.present?
            = render 'documents/related_group', title: 'Unter derselben Nummer', documents: related_documents, id: 'same'
          - if referenced_documents.present?
            = render 'documents/related_group', title: 'Verweist auf', documents: referenced_documents, id: 'referenced'
          - if citing_documents.present?
            = render 'documents/related_group', title: 'Erwähnt in', documents: citing_documents, id: 'citing'

  .col-md-4
    - if agenda_items.present?
      .card.mt-3
        .card-header.fw-bold
          | Bera&shy;tungs&shy;reihen&shy;folge
        .card-body
          .row
            .col-9.border-bottom.py-2 Datum/Gremium
            .col-3.border-bottom.py-2.text-end TOP

          - agenda_items.each do |item|
            .row.py-2.border-top
              .col-9.fw-bold
                = l item.meeting.date
              .col-3.text-end
                - if item.allris_id.present?
                  => link_to minutes_meeting_path(item.meeting, anchor: item.id), title: "Protokoll zu #{item.number}", data: { bs_toggle: :tooltip } do
                    strong= item.number
                  = meeting_result_badge(item)
                - else
                  = item.number
              .col.col-12
                = link_to item.meeting.committee.name, meeting_path(item.meeting)

    - if attachments
      .card.mt-3
        .card-header.fw-bold Anhänge
        .card-body.allris-content
          == document_format(@document, :attached)

          .mt-3
            - @document.attachments.by_name.each do |attachment|
              = link_to attachment.name, rails_blob_path(attachment.file, disposition: :inline), target: '_blank'
              br

    - if similar_documents.present?
      .card.mt-3
        .card-header.fw-bold
          ' Ähnliche Drucksachen
          span.badge.bg-info-subtle.text-info-emphasis.float-end Beta
        .card-body.py-0
          .list-group.list-group-flush
            - similar_documents.each do |similar_document|
              = render 'documents/item', document: similar_document, compact: true, district: @document.district
          p.small.text-secondary.border-top.py-2.mb-0
            | Aus allen Bezirken, automatisch nach inhaltlicher Nähe gefunden. Sie können dasselbe Anliegen betreffen
              oder nur ein ähnliches Thema.

    .card.mt-3
      .card-header.fw-bold
        ' Lokalisation
        span.badge.bg-info-subtle.text-info-emphasis.float-end Beta

      .card-body.pt-2.pb-0
        - if @document.locations.present?
          .d-flex.flex-wrap.gap-1
            - @document.locations.each do |location|
              = place_chip(location)

          / The Stadtteile those places fall into, a coarser second layer below
          / the places.
          - quarters = @document.locations.flat_map(&:quarters).uniq.sort.filter_map { |name| Quarter.lookup(name) }.select(&:district)
          - if quarters.present?
            .mt-3
              .small.text-secondary.mb-1 Stadtteile
              .d-flex.flex-wrap.gap-1
                - quarters.each do |quarter|
                  = quarter_chip(quarter)
        - else
          p.mb-0
            | Keine Orte erkannt.

        p.small.text-secondary.border-top.py-2.mt-2.mb-0
          | Die Erkennung von Orten anhand des Textes der Drucksache kann ungenau sein. Es ist daher möglich, das Orte
            gar nicht oder falsch erkannt werden.

    .card.mt-3
      .card-header.fw-bold
        ' Themen
        span.badge.bg-info-subtle.text-info-emphasis.float-end Beta

      .card-body.pt-2.pb-0
        - if @document.topic_records.present?
          .d-flex.flex-wrap.gap-1
            - @document.topic_records.each do |topic|
              = topic_chip(topic, topic_path(topic:, district: @document.district))
        - else
          p.mb-0
            | Keine Themen erkannt.

        p.small.text-secondary.border-top.py-2.mt-2.mb-0
          | Die Themen werden automatisch anhand von Stichworten, Ausschüssen und Orten zugeordnet und können daher
            unvollständig oder falsch sein.



script type="application/ld+json"
  == structured_data_for_document(@document).to_json
