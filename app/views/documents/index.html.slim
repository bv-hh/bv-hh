= page_header 'Drucksachen', crumbs: ['Drucksachen'] do
  = "#{number_with_delimiter @documents.total_count} Anträge, Anfragen und Vorlagen, die neuesten zuerst"

.list-group.list-group-flush
  - @documents.each do |document|
    = render 'documents/item', document:, places: document_places(document)

.mt-5
  = paginate @documents, theme: 'bootstrap-5', nav_class: "nav justify-content-center"
