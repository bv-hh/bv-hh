/ A district's statistics, or all of Hamburg's without one (CityStatistics).
/ Cached for a day: a day's Drucksachen barely move the figures, and the page
/ runs some twenty queries, for all of Hamburg for several seconds.
- cache ['statistics', @district || 'hamburg', Topic::VERSION], expires_in: 24.hours do
  - outcomes = @statistics.proposal_outcomes
  - rate = @statistics.adoption_rate

  h1.mb-1 Statistiken
  p.text-secondary
    = @district&.name || 'Hamburg'
    - if @statistics.start_date
      =< "· Wahlperiode seit #{l(@statistics.start_date, format: '%B %Y')}"
    =< "· Stand #{l(Date.current, format: :long)}"

  .row.row-cols-2.row-cols-lg-4.g-3.mb-3
    - [[@statistics.document_count, 'Drucksachen', (documents_path if @district)],
       [@statistics.meeting_count, 'Sitzungen', (meetings_path if @district)],
       [@statistics.proposal_count, 'Anträge', '#entscheidungen'],
       [@statistics.inquiry_count, 'Anfragen an das Bezirksamt', nil]].each do |count, label, path|
      .col
        .card.h-100.bg-body-tertiary
          .card-body
            p.h2.fw-bold.mb-0= number_with_delimiter(count)
            - if path
              = link_to label, path, class: 'stretched-link'
            - else
              = label

  nav.nav.mb-5 aria-label='Abschnitte'
    - sections = [%w[themen Themen], %w[entscheidungen Entscheidungen], %w[orte Orte], %w[verlauf Verlauf]]
    - sections << %w[fraktionen Fraktionen] if @district
    - sections.each do |id, label|
      = link_to label, "##{id}", class: 'nav-link ps-0 py-1'

  - if @statistics.topic_counts.any?
    section#themen.mb-5
      .row.g-4
        .col-lg-4
          h2 Worüber beraten wird
          p.text-secondary
            ' Jede Drucksache ist automatisch einem oder mehreren Themen zugeordnet. Manche gehören zu keinem.
        .col-lg-8
          = render 'topics/bars', items: @statistics.topic_counts, top: 10,
                   url: ->(topic) { topic_path(topic:, district: @district&.to_param) }

          - timeline = @statistics.topic_timeline
          - if timeline.any?
            h3.h5.mt-5 Die häufigsten Themen im Verlauf
            p.small.text-secondary
              ' Drucksachen je Quartal, gezählt in der ersten Sitzung, die sie beraten hat. Das laufende Quartal fehlt
                noch.
            = line_chart timeline, colors: StatisticsController::SERIES_COLORS, curve: false, legend: 'bottom',
                         library: { elements: { line: { borderWidth: 2 }, point: { radius: 3 } } }

  - if outcomes.values.sum.positive?
    section#entscheidungen.mb-5
      .row.g-4
        .col-lg-4
          h2 Was aus Anträgen wird
          - if rate
            p.display-5.fw-bold.mb-0= number_to_percentage(100 * rate, precision: 0)
            p.text-secondary
              ' der Anträge, über die schon entschieden ist, wurden beschlossen – unverändert oder geändert.
          p.small.text-secondary
            ' „Noch offen“ heißt: Es ist kein Beschluss erfasst, etwa weil der Antrag vertagt oder an einen Ausschuss
              überwiesen wurde.
        .col-lg-8
          = render 'outcome_bar', outcomes:, label: 'Alle Anträge', css: 'outcome-bar-lg'
          ul.list-inline.small.mt-2
            - outcomes.each do |outcome, count|
              li.list-inline-item.me-3
                span.legend-swatch class="outcome-#{outcome}"
                => DistrictStatistics::OUTCOMES[outcome]
                span.text-secondary= number_with_delimiter(count)

          - by_topic = @statistics.outcomes_by_topic
          - if by_topic.any?
            h3.h5.mt-5 Nach Thema
            .vstack.gap-2
              - by_topic.each do |topic, topic_outcomes|
                .row.g-2.align-items-center
                  .col-sm-4
                    = link_to topic.label, topic_path(topic:, district: @district&.to_param), class: 'fw-semibold'
                  .col
                    = render 'outcome_bar', outcomes: topic_outcomes, label: topic.label
                  .col-2.text-end.small.text-secondary= number_with_delimiter(topic_outcomes.values.sum)

  - if @district.nil?
    - choropleth = Choropleth.new(@statistics.district_areas)
    section#orte.mb-5
      .row.g-4
        .col-lg-4
          h2 Die Bezirke im Vergleich
          p.text-secondary
            ' Drucksachen der laufenden Wahlperiode, gemessen an den Menschen, die im Bezirk wohnen. Hier zählen alle
              Drucksachen: Was eine Bezirksversammlung berät, betrifft ihren Bezirk.
          p.small.text-secondary
            ' Die Farben teilen die sieben Bezirke in bis zu fünf Gruppen.
            = render 'choropleths/population_source'
        .col-lg-8
          - url = ->(district) { statistics_path(district:) }
          = render 'choropleths/map', choropleth:, url:, bounds: District.city_bounds, unit: 'Bezirk'
          .mt-4
            = render 'choropleths/table', choropleth:, url:, unit: 'Bezirk'

  - elsif (choropleth = Choropleth.new(@statistics.quarter_areas)).any?
    section#orte.mb-5
      .row.g-4
        .col-lg-4
          h2 Wo es um Orte geht
          p.text-secondary
            ' Wie viele Drucksachen einen Stadtteil oder einen Ort darin nennen, gemessen an den Menschen, die dort
              wohnen – sonst lägen die großen Stadtteile immer vorn. Eine Drucksache kann mehrere Stadtteile
              betreffen.
          p.small.text-secondary
            ' Die Farben teilen die Stadtteile des Bezirks in fünf etwa gleich große Gruppen.
            = render 'choropleths/population_source'
          = link_to 'Alle Orte auf der Karte', map_path
        .col-lg-8
          - url = ->(quarter) { quarter_path(district: quarter.district, quarter: quarter.slug) }
          = render 'choropleths/map', choropleth:, url:, bounds: @district.bounds, unit: 'Stadtteil'
          .mt-4
            = render 'choropleths/table', choropleth:, url:, unit: 'Stadtteil'

  - monthly = @statistics.monthly_timeline
  - if monthly.any?
    section#verlauf.mb-5
      .row.g-4
        .col-lg-4
          h2 Wie viel beraten wird
          p.text-secondary
            ' Drucksachen je Monat, gezählt in der ersten Sitzung, die sie beraten hat. Im Sommer ruhen die
              Sitzungen. Der laufende Monat fehlt noch.
        .col-lg-8
          = line_chart monthly, colors: StatisticsController::SERIES_COLORS, curve: false, legend: 'bottom',
                       library: { elements: { line: { borderWidth: 2 }, point: { radius: 3 } } }

  - if @district
    section#fraktionen.mb-5
      .row.g-4
        .col-lg-4
          h2 Anträge und Anfragen der Fraktionen
          p.text-secondary
            ' Gezählt nach dem Titel oder den Verfassenden einer Drucksache, daher ungefähr. Gemeinsame Anträge
              zählen für jede beteiligte Fraktion.
        .col-lg-8
          = column_chart @statistics.party_series, legend: 'bottom'
