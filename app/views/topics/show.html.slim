- topic_feed_url = feed_url(format: :rss, district: @district&.to_param, topics: [@topic.slug])

- content_for :head do
  = auto_discovery_link_tag :rss, topic_feed_url, title: "Drucksachen zum Thema #{@topic.label}"

- feed_button = capture do
  = link_to topic_feed_url, class: 'btn btn-outline-secondary', title: "RSS-Feed zum Thema #{@topic.label}",
      rel: 'alternate', type: 'application/rss+xml' do
    = icon('fas', 'rss')
    span.visually-hidden RSS-Feed abonnieren

= page_header @topic.label, kind: 'Thema', crumbs: [@topic.label], actions: feed_button do
  - if @district
    ' Thema in
    => @district.name
    ' ·
    = link_to 'alle Bezirke', topic_path(topic: @topic, district: nil)
  - else
    | Thema in allen Hamburger Bezirken

.beta.mb-3
  span.badge.text-bg-warning> Beta
  span.small.text-secondary
    | Die Themen werden automatisch anhand von Stichworten, Ausschüssen und Orten zugeordnet. Es ist daher möglich,
      dass hier Drucksachen fehlen oder nicht zum Thema passen.

- districts = District.by_order.select { |district| @district_counts[district.id].to_i.positive? }
- if districts.size > 1
  .d-flex.flex-wrap.gap-2.mb-4
    = filter_chip('Alle Bezirke', topic_path(topic: @topic, district: nil), selected: @district.nil?,
        count: @district_counts.values.sum, current: 'page')
    - districts.each do |district|
      = filter_chip(district.name, topic_path(topic: @topic, district: district.to_param), selected: district == @district,
          count: @district_counts[district.id], current: 'page')

- if @documents.any?
  p.text-secondary
    = "#{number_with_delimiter @documents.total_count} #{@documents.total_count == 1 ? 'Drucksache' : 'Drucksachen'} zum Thema #{@topic.label}."

  .list-group.list-group-flush
    - @documents.each do |document|
      = render 'documents/item', document:, places: document_places(document), topics: document.topic_records - [@topic],
          topic_url: ->(topic) { topic_path(topic:, district: @district&.to_param) }

  .mt-4
    = paginate @documents, theme: 'bootstrap-5', nav_class: 'nav justify-content-center'
- else
  p.mt-2
    | Zu diesem Thema sind bisher keine Drucksachen erfasst.

.mt-5.pt-3.border-top
  h2.h6 Weitere Themen
  = render 'topics/chips', items: @topic_counts, active: @topic.key,
      url: ->(topic) { topic_path(topic: topic, district: @district&.to_param) }
