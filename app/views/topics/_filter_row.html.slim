/ topics/_filter as one row to swipe through, for where a sidebar does not fit.
/ Same locals.
nav.d-flex.d-lg-none.flex-nowrap.overflow-x-auto.gap-2.pb-2.mb-3 aria-label='Themen'
  = filter_chip('Alle Themen', url.call(nil), selected: active.nil?, pill: true)
  - items.each do |topic, count|
    - selected = topic == active
    = filter_chip(topic.label, url.call(selected ? nil : topic), selected:, count:, pill: true)
