- district_feed_url = feed_url(format: :rss, district: @district.to_param)

- content_for :head do
  = auto_discovery_link_tag :rss, district_feed_url, title: "Drucksachen aus #{@district.name}"

.district
  = breadcrumbs @district.name, district: nil

  .card.p-4.p-lg-5.mb-5.bg-body-tertiary.rounded-3
    .row.g-5
      .col-lg-7
        p.text-uppercase.fw-bold.small.text-secondary.mb-2 Bezirk
        h1.display-5.fw-bold.mb-3= @district.name
        p.lead.mb-4 Bezirksversammlung, Ausschüsse und Drucksachen aus #{@quarters.size} Stadtteilen.

        = render 'search/hero', label: "In #{@district.name} suchen"

        .d-flex.flex-wrap.gap-4.mt-4
          - [[@document_count, 'Drucksachen'], [@meeting_count, 'Sitzungen'], [@quarters.size, 'Stadtteile']].each do |value, label|
            div
              .fs-3.fw-bold.lh-1= number_with_delimiter(value)
              .small.text-secondary= label

        - if @quarters.present?
          section.mt-4
            h2.h6.mb-1 Ihr Stadtteil
            p.small.text-secondary.mb-2 Drucksachen, die einen Ort im Stadtteil erwähnen – jeweils auch als RSS-Feed.
            .d-flex.flex-wrap.gap-2
              - @quarters.each do |quarter|
                = quarter_chip(quarter)

      .col-lg-5
        .card
          - if @next_assembly
            .card-header.text-bg-brand.position-relative.p-3
              .small.text-uppercase.fw-bold.opacity-75 Nächste Bezirksversammlung
              .fs-3.fw-bold= l(@next_assembly.date, format: '%-d. %B')
              .opacity-75
                = l(@next_assembly.date, format: '%A')
                - if @next_assembly.start_time
                  | , #{l(@next_assembly.start_time)} Uhr
                '  ·
                = days_until(@next_assembly.date)
              = link_to 'Tagesordnung ansehen', meeting_path(@next_assembly), class: 'stretched-link link-light'
          .card-body.pb-2
            h2.h5.card-title Öffentliche Sitzungen
          - if @next_meetings.any?
            .list-group.list-group-flush
              - @next_meetings.each do |meeting|
                .list-group-item.list-group-item-action.position-relative.d-flex.align-items-baseline
                  = link_to l(meeting.date, format: '%a %d.%m.'), meeting_path(meeting),
                      class: 'stretched-link fw-bold text-nowrap col-3'
                  span.flex-grow-1
                    = meeting.committee&.name || meeting.title
                    - if meeting.start_time
                      small.d-block.text-secondary #{l(meeting.start_time)} Uhr
          - else
            p.card-body.pt-0.text-secondary Derzeit sind keine Sitzungen angekündigt.
          .card-body.pt-2
            = link_to "Alle Termine in #{@district.name}", meetings_path

  .row.g-5.mb-5
    section.col-lg-7
      .d-flex.flex-wrap.justify-content-between.align-items-baseline.column-gap-3.mb-2
        h2.mb-0 Neue Drucksachen
        div
          => link_to 'Alle Drucksachen', documents_path
          = link_to district_feed_url, class: 'ms-2', rel: 'alternate', type: 'application/rss+xml',
              title: "RSS-Feed aller Drucksachen aus #{@district.name}" do
            = icon('fas', 'rss', 'RSS')
      .list-group.list-group-flush
        - @documents.each do |document|
          = render 'documents/item', document:, compact: true

    - if @topic_counts.present?
      section.col-lg-5
        h2.mb-1 Themen
        p.small.text-secondary Drucksachen nach Thema, automatisch zugeordnet.
        = render 'topics/bars', items: @topic_counts, top: DistrictsController::TOP_TOPICS,
                 url: ->(topic) { topic_path(topic:) }

  / Cached for a day, like the statistics page: a day's Drucksachen barely move
  / the shades.
  - cache ['quarter_choropleth', @district], expires_in: 24.hours do
    - choropleth = Choropleth.new(DistrictStatistics.new(@district).quarter_areas)
    - if choropleth.any?
      section.mb-5
        .row.g-4
          .col-lg-4
            h2 Wo beraten wird
            p.text-secondary
              ' Wie viele Drucksachen der laufenden Wahlperiode einen Stadtteil oder einen Ort darin nennen,
                gemessen an den Menschen, die dort wohnen.
            ul.list-unstyled
              li= link_to 'Alle Zahlen zu den Stadtteilen', statistics_path(anchor: 'orte')
              li= link_to 'Was bei Ihnen in der Nähe beraten wird', map_path
          .col-lg-8
            = render 'choropleths/map', choropleth:, unit: 'Stadtteil', bounds: @district.bounds,
                     url: ->(quarter) { quarter_path(district: quarter.district, quarter: quarter.slug) }

  = render 'pages/participation', heading: "Mitmachen in #{@district.name}"

  section.mb-5
    h2.h5 Anderer Bezirk
    nav.d-flex.flex-wrap.gap-2 aria-label='Bezirke'
      - District.by_order.each do |district|
        = filter_chip(district.name, root_with_district_path(district:), selected: district == @district, current: 'page')

  .alert.alert-warning.mb-0
    strong> Keine offizielle Seite der Stadt Hamburg.
    ' Kopie aus dem Ratsinformationssystem unter
    - allris_url = "#{@district.allris_base_url}/bi/allris.net.asp"
    => link_to allris_url, allris_url, target: '_blank', rel: 'noopener', class: 'alert-link'
    ' – nur dort sind verbindliche Informationen zu finden. Über das Symbol
    => allris_icon
    ' gelangen Sie zur jeweiligen Quelle.
    = link_to 'Wozu dann das hier?', about_path(district: nil), class: 'alert-link'
